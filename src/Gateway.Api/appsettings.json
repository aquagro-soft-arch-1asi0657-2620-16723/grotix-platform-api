{
  "ReverseProxy": {
    "Routes": {
      "health-ready-telemetry": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/ready/telemetry"
        }
      },
      "health-ready-core": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/ready/core"
        }
      },
      "telemetry-health": {
        "ClusterId": "telemetry-cluster",
        "Match": {
          "Path": "/api/v1/telemetry/health/{**catch-all}"
        }
      },
      "telemetry-api": {
        "ClusterId": "telemetry-cluster",
        "Match": {
          "Path": "/api/v1/telemetry/{**catch-all}"
        }
      },
      "hardware-api": {
        "ClusterId": "hardware-cluster",
        "Match": {
          "Path": "/api/v1/hardware/{**catch-all}"
        }
      },
      "irrigation-api": {
        "ClusterId": "irrigation-cluster",
        "Match": {
          "Path": "/api/v1/irrigation/{**catch-all}"
        }
      },
      "profiles-search": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/search"
        }
      },
      "profiles-legacy": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/profile/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/profile"
          },
          {
            "PathPrefix": "/api/v1/profile"
          }
        ]
      },
      "auth-legacy": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "profiles-legacy-associations": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/associations/{**catch-all}"
        }
      },
      "profiles-legacy-roles": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/roles/{**catch-all}"
        }
      },
      "profiles-legacy-staff": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/staff/{**catch-all}"
        }
      },
      "profiles-legacy-admin-users": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        }
      },
      "profiles-legacy-users-root": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/users"
        }
      },
      "profiles-legacy-users": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "profiles-legacy-contracts-root": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/contracts"
        }
      },
      "profiles-legacy-contracts": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/contracts/{**catch-all}"
        }
      },
      "cultivation-legacy-farms": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/api/v1/farms/{**catch-all}"
        }
      },
      "cultivation-legacy-zones": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/api/v1/zones/{**catch-all}"
        }
      },
      "cultivation-legacy-catalog": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "crop-analysis-api": {
        "ClusterId": "crop-analysis-cluster",
        "Match": {
          "Path": "/api/v1/analysis/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      },
      "openapi-profiles": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/docs/profiles/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-cultivation": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/docs/cultivation/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-telemetry": {
        "ClusterId": "telemetry-cluster",
        "Match": {
          "Path": "/docs/telemetry/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-hardware": {
        "ClusterId": "hardware-cluster",
        "Match": {
          "Path": "/docs/hardware/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-irrigation": {
        "ClusterId": "irrigation-cluster",
        "Match": {
          "Path": "/docs/irrigation/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      }
    },
    "Clusters": {
      "profiles-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://profiles:8080/"
          }
        }
      },
      "cultivation-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://cultivation:8080/"
          }
        }
      },
      "telemetry-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://telemetry:8080/"
          }
        }
      },
      "hardware-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://hardware:8080/"
          }
        }
      },
      "irrigation-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://irrigation:8080/"
          }
        }
      },
      "crop-analysis-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://crop-analysis:8000/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
