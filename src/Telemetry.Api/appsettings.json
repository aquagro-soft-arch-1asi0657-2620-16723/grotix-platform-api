{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "TelemetryTimescale": ""
  },
  "MySql": {
    "ServerVersion": "8.0.36"
  },
  "RabbitMq": {
    "Enabled": false,
    "ExchangeName": "grotix.events",
    "TelemetryReceivedQueueName": "telemetry.received",
    "TelemetryReceivedRoutingKey": "telemetry.received",
    "AlertTriggeredRoutingKey": "alert.triggered",
    "AlertNotificationQueueName": "profiles.alert.triggered",
    "DeviceHeartbeatRoutingKey": "device.heartbeat"
  },
  "Telemetry": {
    "SensorCalibrations": {
      "Sensors": []
    },
    "HumidityScales": {
      "DefaultScale": "Percent",
      "Devices": []
    },
    "Alerts": {
      "SustainedReadingsBeforeAlert": 4
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
