{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "TelemetryTimescale": ""
  },
  "MySql": {
    "ServerVersion": "8.0.36"
  },
  "RabbitMq": {
    "Enabled": false,
    "ExchangeName": "grotix.events",
    "ActuatorCommandQueueName": "hardware.actuator.command",
    "ActuatorCommandRoutingKey": "hardware.actuator.command",
    "DeviceStatusChangedRoutingKey": "hardware.device.status.changed",
    "DeviceHeartbeatRoutingKey": "device.heartbeat",
    "DeviceHeartbeatQueueName": "hardware.device.heartbeat"
  },
  "Hardware": {
    "DevicePresence": {
      "Enabled": true,
      "OfflineAfterMinutes": 60,
      "CheckIntervalMinutes": 5
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
