# Grotix: AUTO-GENERATED PLACEHOLDERS. Use scripts/init-env.ps1 or scripts/init-env.sh.
# Docker local / Azure VM unica: los contenedores usan puertos internos 3306/5432.
# NEVER commit .env to Git; the templates are intentionally not secrets.
JWT_SECRET=REPLACE_JWT_SECRET
GROTIX_DATABASE_MODE=vm
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PUBLISHED_PORT=3307
MYSQL_DB=grotix_core
MYSQL_USER=grotix
MYSQL_PASSWORD=REPLACE_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_MYSQL_ROOT_PASSWORD
MYSQL_SSL_MODE=Disabled
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5433
POSTGRES_DB=grotix_telemetry
POSTGRES_USER=grotix
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
POSTGRES_SSL_MODE=Disable
POSTGRES_TRUST_SERVER_CERTIFICATE=false
BOOTSTRAP_ADMIN_EMAIL=admin@grotix.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_BOOTSTRAP_ADMIN_PASSWORD
GROTIX_DOMAIN=api.example.com
CORS_ALLOWED_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
RABBITMQ_ENABLED=false
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=grotix
RABBITMQ_PASSWORD=REPLACE_RABBITMQ_PASSWORD
RABBITMQ_URI=
# El backend de Crop Analysis no se incluye en este repositorio.
CROP_ANALYSIS_URL=http://crop-analysis:8000/
IMAGE_PREFIX=grotix-
IMAGE_TAG=local
GATEWAY_PORT=5100
