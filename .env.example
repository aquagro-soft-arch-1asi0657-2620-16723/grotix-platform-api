# Copia este archivo a .env. Nunca subas .env a GitHub.
# Valores de muestra: reemplazar todos los REPLACE_ME con credenciales reales.
JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_ASCII_SECRET_AT_LEAST_32_CHARACTERS
GROTIX_DATABASE_MODE=external
MYSQL_HOST=your-mysql-server.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DB=grotix_core
MYSQL_USER=grotix
MYSQL_PASSWORD=REPLACE_ME
MYSQL_ROOT_PASSWORD=REPLACE_ME
MYSQL_SSL_MODE=VerifyFull
POSTGRES_HOST=your-postgres-server.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=grotix_telemetry
POSTGRES_USER=grotix
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_SSL_MODE=VerifyFull
POSTGRES_TRUST_SERVER_CERTIFICATE=false
# JWT admin inicial solo durante primer arranque; borrar luego del .env:
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Dominio real y DNS A hacia la IP pública de la VM Azure (perfil public)
GROTIX_DOMAIN=api.example.com
CORS_ALLOWED_ORIGIN=https://app.example.com
# Swagger/OpenAPI solo habilitar para demo o redes confiables.
SWAGGER_ENABLED=false
# RabbitMQ deshabilitado hasta provisionar broker seguro.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=grotix
RABBITMQ_PASSWORD=REPLACE_ME
RABBITMQ_URI=
# Analítica Crop Analysis: debe publicarse por separado, en la misma red o URL externa.
CROP_ANALYSIS_URL=http://crop-analysis:8000/
# Imágenes de GHCR: ghcr.io/aguagro/grotix- ; tag publicado: vX.Y.Z
IMAGE_PREFIX=grotix-
IMAGE_TAG=local
GATEWAY_PORT=5100
